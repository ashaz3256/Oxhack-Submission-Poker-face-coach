# Leave blank to use local SQLite. For Tiger Data, paste the Postgres connection string
# (postgresql+psycopg://user:pass@host:port/tsdb?sslmode=require) and run schema.sql once.
DATABASE_URL=
# Optional: Gemini writes the session review. Without it the review is a template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: ElevenLabs speaks the coach. Without it the browser's built-in voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
