# Optional: the AIs improvise their lines and Gemini writes your post-game review.
GEMINI_API_KEY=
# Optional: force a model. By default we try gemini-flash-lite-latest, then gemini-flash-latest.
GEMINI_MODEL=
# Optional: a distinct ElevenLabs voice per player. Override any with ELEVENLABS_VOICE_AVA, _BEN, _CLEO, _DEV, _ELI, _NARRATOR.
ELEVENLABS_API_KEY=
# Expressive real-time model with delivery tags like [whispers]; falls back to ELEVENLABS_MODEL
# (default eleven_multilingual_v2) if unavailable. Set to off to skip it.
ELEVENLABS_EXPRESSIVE_MODEL=eleven_v4
# Designed character voices ("Tilt - Ava" etc.). They live in Arij's ElevenLabs workspace, so they
# only work with a key from that account; with any other key leave these commented out.
# ELEVENLABS_VOICE_NARRATOR=JzSgR8N7PuKZSfSsjwEe
# ELEVENLABS_VOICE_AVA=DvCafLULQSul8Zu6ceRV
# ELEVENLABS_VOICE_BEN=jn4QYu9GZtUpOCkWfnKm
# ELEVENLABS_VOICE_CLEO=8RPXI5IgscawU8oc58hR
# ELEVENLABS_VOICE_DEV=cR1yT757VDzqLGGnzs9f
# ELEVENLABS_VOICE_ELI=rgRIlotgMMEhty84Ltiy
# Sound effects: run `python scripts/make_sfx.py` once after setting the key.
# Optional: Presage heart rate and breathing rate from the webcam (physiology.presagetech.com).
PRESAGE_API_KEY=
# Optional: Tiger Data (Postgres) connection string, e.g. postgresql+psycopg://user:pass@host:port/tsdb?sslmode=require
# Leave blank for local SQLite.
DATABASE_URL=
