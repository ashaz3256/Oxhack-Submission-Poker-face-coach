# Optional: the AIs improvise their lines and Gemini writes your post-game review.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: a distinct ElevenLabs voice per player. Override any with ELEVENLABS_VOICE_AVA, _BEN, _CLEO, _DEV, _ELI, _NARRATOR.
ELEVENLABS_API_KEY=
# eleven_v4_turbo: real-time with delivery tags like [whispers]. Falls back to eleven_flash_v2_5 automatically.
ELEVENLABS_MODEL=eleven_v4_turbo
# Sound effects: run `python scripts/make_sfx.py` once after setting the key.
# Optional: Tiger Data (Postgres) connection string, e.g. postgresql+psycopg://user:pass@host:port/tsdb?sslmode=require
# Leave blank for local SQLite.
DATABASE_URL=
